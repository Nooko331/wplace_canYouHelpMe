<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Wplace.Desktop.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Shared/PixelTheme.axaml" />
    <Style Selector="Button.pixel.text"><Setter Property="Height" Value="38" /></Style>
    <Style Selector="ScrollBar"><Setter Property="CornerRadius" Value="0" /></Style>
    <Style Selector="CheckBox"><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="0" /></Style>
  </Application.Styles>
</Application>
